{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.bun/bin/bun $HOME/.codex/hooks/RecallContext.hook.ts"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.bun/bin/bun $HOME/.codex/hooks/IntentRecall.hook.ts"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/compound hook pre-tool-use --live --harness codex"
          }
        ]
      }
    ]
  }
}
