<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ssd-guardian.budget-daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.bun/bin/bun</string>
    <string>__HOME__/Projects/systems/compound/scripts/ssd-guardian/enforce_ssd_budget.ts</string>
    <string>--apply</string>
    <string>--no-discovery</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:__HOME__/.bun/bin:__HOME__/.local/bin</string></dict>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>5</integer><key>Minute</key><integer>0</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/ssd-guardian-budget-daily.out.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/ssd-guardian-budget-daily.err.log</string>
</dict>
</plist>
