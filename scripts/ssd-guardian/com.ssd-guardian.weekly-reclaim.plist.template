<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Install: sed "s|__HOME__|$HOME|g" com.ssd-guardian.weekly-reclaim.plist.template > "$HOME/Library/LaunchAgents/com.ssd-guardian.weekly-reclaim.plist" && launchctl bootstrap "gui/$(id -u)" "$HOME/Library/LaunchAgents/com.ssd-guardian.weekly-reclaim.plist" -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ssd-guardian.weekly-reclaim</string>

  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.bun/bin/bun</string>
    <string>__HOME__/Projects/systems/compound/scripts/ssd-guardian/weekly_reclaim.ts</string>
    <string>--apply</string>
  </array>

  <!-- Sunday 03:00 local time. After nightly NAS sync, before the workweek. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>0</integer>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/ssd-guardian-weekly.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/ssd-guardian-weekly.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:__HOME__/.bun/bin:__HOME__/.local/bin</string>
  </dict>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
